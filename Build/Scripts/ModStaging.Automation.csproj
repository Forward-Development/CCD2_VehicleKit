<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(EngineDir)\Source\Programs\Shared\UnrealEngine.csproj.props" Condition="'$(EngineDir)' != ''" />

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>ModStaging</RootNamespace>
    <AssemblyName>ModStaging.Automation</AssemblyName>
    <OutputPath>$(MSBuildProjectDirectory)\Intermediate\ScriptModules\ModStaging\</OutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="AutomationUtils.Automation">
      <HintPath>$(EngineDir)\Binaries\DotNET\AutomationTool\AutomationUtils\$(TargetFramework)\AutomationUtils.Automation.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="EpicGames.Core">
      <HintPath>$(EngineDir)\Binaries\DotNET\AutomationTool\AutomationUtils\$(TargetFramework)\EpicGames.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnrealBuildTool">
      <HintPath>$(EngineDir)\Binaries\DotNET\AutomationTool\AutomationUtils\$(TargetFramework)\UnrealBuildTool.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
